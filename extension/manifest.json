{
  "manifest_version": 3,
  "name": "KomaTranslator Live",
  "version": "1.1.0",
  "description": "Traduit en direct le texte des manhwa / manhua / manga affichés dans la page.",
  "permissions": ["storage", "declarativeNetRequest", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*"], "matches": ["<all_urls>"] }
  ],
  "action": { "default_popup": "popup.html", "default_title": "KomaTranslator" },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Activer / désactiver la traduction sur ce site"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "komatranslator-live@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
